# All optional. Defaults work out of the box.
PORT=3000
HOST=0.0.0.0

# Largest meeting. Peer-to-peer meshes get heavy past ~6-8 people.
MAX_PEERS=6

# Comma-separated origins allowed to open the signalling socket. Empty = same origin only.
ALLOWED_ORIGINS=

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=0

# Path to a brand file (see brand.json). Defaults to ./brand.json
BRAND_FILE=

# Extra ICE servers as a JSON array, e.g. [{"urls":"stun:stun.example.com:3478"}]
ICE_SERVERS=

# TURN with short-lived credentials (coturn `use-auth-secret` / `static-auth-secret`).
TURN_URLS=
TURN_SECRET=
